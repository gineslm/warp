{
  "autoMemoryEnabled": false,
  "permissions": {
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh release create *)"
    ],
    "deny": [
      "Bash(gh pr merge *--squash*)",
      "Bash(gh pr merge * -s*)",
      "Bash(gh pr merge *--rebase*)",
      "Bash(gh pr merge * -r*)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)"
    ],
    "allow": [
      "Bash(git branch -d *)",
      "Bash(git fetch --prune*)"
    ]
  }
}
